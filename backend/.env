# ============================================================
# 极睿知识库 · 生产配置（阿里云 ECS 47.104.154.66）
# 生成时间：2026-09-10
#
# 本文件含密钥，落盘权限必须 600，不得进版本库。
# 部署位置：/opt/jirui/backend/.env
# ============================================================

# ---------------- 应用 ----------------
APP_NAME=极睿知识库
APP_VERSION=0.1.0
DEBUG=false
TZ=Asia/Shanghai

# ---------------- 数据目录 ----------------
# 业务库(SQLite)/上传件/日志/索引都落在这里
DATA_DIR=/opt/jirui/data

# ---------------- 数据库 ----------------
# 留空 = SQLite，实际路径 /opt/jirui/data/jirui.db
# 要切回 PostgreSQL，填 postgresql+asyncpg://user:pwd@host:5432/db 即可
DATABASE_URL=

# ---------------- 检索内核 ----------------
# local = 内置轻量内核（SQLite 全文 + 本地 ONNX 嵌入），无需 RAGFlow
# ragflow = 外部 RAGFlow 服务，需另行部署
RETRIEVAL_BACKEND=local
# 留空 = /opt/jirui/data/index/chunks.db
INDEX_DB_PATH=

# ---------------- 本地嵌入模型 ----------------
EMBEDDING_MODEL=bge-small-zh-v1.5
EMBEDDING_DIM=512
LOCAL_EMBEDDING_DIR=/opt/jirui/models/bge-small-zh-v1.5

# ---------------- 认证密钥（勿改勿泄，改了全体用户强制掉线）----------------
JWT_SECRET=e_7X1xpLvxgjw9brL4tZjm2-c9Jhum_OONn5aH8xETR74CH61S4y6Izi_edFwKdd
SECRET_ENCRYPTION_KEY=0GApC5cwjXJtrhrgCqJIB4LRyJ8J5_geFS6H0sESdKk=

# ---------------- 初始管理员（仅首次启动建号时生效）----------------
ADMIN_USERNAME=admin
ADMIN_INIT_PASSWORD=I_79^OGB1G+Z5Z1K^G
ADMIN_DISPLAY_NAME=系统管理员
ADMIN_EMAIL=admin@jirui.local

# ---------------- CORS ----------------
# null 不能删：Electron 桌面端从 file:// 加载，Origin 就是字面量 "null"
ALLOWED_ORIGINS=null,http://localhost,http://127.0.0.1,http://47.104.154.66,http://47.104.154.66:8000,http://47.104.154.66:8081

# ---------------- 默认大模型（问答用）----------------
# 也可以在管理后台「模型管理」里配置，那个入口会把 Key 加密入库。
DEFAULT_LLM_PROVIDER=deepseek
DEFAULT_LLM_MODEL=deepseek-chat
DEFAULT_LLM_BASE_URL=https://api.deepseek.com/v1
DEFAULT_LLM_API_KEY=
